# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.editorconfig
!.*.example
!.obsidian/
!.obsidian/**
!/.todoscope-exclude.csv
!.eleventy.js
!/src/style-core/.gitignore
!/src/style-core/.gitattributes
!/src/style-core/.github/
!/src/style-core/.github/**

# Build & runtime junk (anchor dist/ to root — src/style-core/dist/ is tracked)
node_modules/
/dist/
*.log
*.tgz
