<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>No region</title>
		<script defer src="/v1/swap.js"></script>
	</head>
	<body>
		<!-- The script is loaded and NO region is declared. This is the shape of a
		     host application that adopted a fetched page's scripts without asking
		     for any of this. Every link here must behave as if the file were not
		     present at all. A `<main>` is here on purpose: an earlier version
		     claimed it by default, which would have hijacked this whole document. -->
		<main>
			<h1 id="who">none</h1>
			<a id="to-b" href="/demo/swap/b.html">to B</a>
		</main>
	</body>
</html>
